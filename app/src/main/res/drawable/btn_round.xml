<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FFFFFFFF" android:endColor="#BBDDF7FF"/>
            <stroke android:width="2dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#99FFFFFF"/>
            <stroke android:width="1dp" android:color="#CCFFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#55FFFFFF" android:endColor="#20CDE7FF"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
</selector>
