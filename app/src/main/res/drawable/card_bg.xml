<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#D9FFFFFF" android:centerColor="#A8DCEBFF" android:endColor="#C8FFFFFF"/>
            <corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#88FFFFFF" android:endColor="#44D9E8FF"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#99FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#42FFFFFF" android:centerColor="#26CDE7FF" android:endColor="#18FFFFFF"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#55FFFFFF"/>
        </shape>
    </item>
</selector>
